{
  "name": "scanvas",
  "productName": "Scanvas",
  "version": "0.1.0",
  "description": "Offline screenshot OCR and document scanner",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Scanvas",
  "license": "MIT",
  "private": true,
  "scripts": {
    "tessdata": "node scripts/copy-tessdata.mjs",
    "predev": "npm run tessdata",
    "dev": "electron-vite dev",
    "prebuild": "npm run tessdata",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "build:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/chi_tra": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/osd": "^1.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zxing-wasm": "^3.1.6"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "chokidar": "^6.0.0",
    "docx": "^9.14.0",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "pdf-lib": "^1.17.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  }
}
